{
  "name": "pey-hackathon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --import tsx src/app.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/app.js",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "demo": "node --import tsx src/demo.ts",
    "local": "node --import tsx src/local.ts",
    "backup": "node --import tsx src/backup.ts",
    "verify": "npm run format:check && npm run check && npm test && npm run build && npm run demo && python3 scripts/check-links.py",
    "check:integrations": "node --import tsx scripts/check-integrations.ts",
    "format:check": "prettier --check src test scripts/check-integrations.ts vitest.config.ts tsconfig.json package.json .github/workflows/ci.yml"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.8",
    "openai": "7.53.0",
    "pino": "10.4.0",
    "proper-lockfile": "4.1.2",
    "qrcode": "1.5.4",
    "standardwebhooks": "1.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/proper-lockfile": "4.1.4",
    "@types/qrcode": "1.5.6",
    "node": "24.22.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
