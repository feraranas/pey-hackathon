# Copy outside version control. Never commit actual keys or session files.
MODE=live
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# Generate: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=
PEY_API_KEY=
# Expected apiKeyId in signed QR webhooks
PEY_API_KEY_ID=
PEY_WEBHOOK_SECRET=whsec_
# Optional: without it the deterministic Spanish RuleExtractor is used
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PUBLIC_BASE_URL=https://your-domain.example
MERCHANT_ID=merchant-1
# Merchant's personal WhatsApp (linked session; reads only picked client chats
# and sends only authorized charges). SELF_JID/SELF_LID are accepted as aliases.
MERCHANT_JID=5215555555555@s.whatsapp.net
# Optional verified LID identity of the merchant
MERCHANT_LID=
# Dedicated product number: the only channel for onboarding, proposals and «Sí»
PRODUCT_JID=5215555555557@s.whatsapp.net
# Optional seed list; clients are normally added by chat ("agrega a Ana 5215550000002")
ALLOWED_CHAT_JIDS=
EXTRACTION_DELAY_MS=30000

# qr (default) or code; pairing is still pending live validation
WHATSAPP_PAIRING_MODE=qr

# Transport per session: baileys (default) or whatsmeow (Go sidecar, see sidecar/)
PRODUCT_TRANSPORT=baileys
MERCHANT_TRANSPORT=baileys
# Required with the whatsmeow transport; a Unix socket in a 0700 directory
PRODUCT_SIDECAR_SOCKET=
MERCHANT_SIDECAR_SOCKET=

# Voice notes: none (default) or openai (needs OPENAI_API_KEY). Only the
# merchant's client chats are transcribed; the audio is never stored.
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_MODEL=

# Daily summary for the merchant, sent once after this local hour (0-23).
# Leave empty to disable; «resumen» always works on request.
SUMMARY_HOUR=
SUMMARY_TIMEZONE=America/Mexico_City
